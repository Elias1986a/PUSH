<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow accessibility API access (for text injection and global hotkeys) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Allow microphone access -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Allow network access (for model downloads) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow file access for model storage -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- App Sandbox DISABLED - Required for global hotkeys and text injection -->
    <!-- Menu bar apps with accessibility features cannot be sandboxed -->
    <!--
    <key>com.apple.security.app-sandbox</key>
    <true/>
    -->

    <!-- Temporary exception for accessibility (needed for text injection) -->
    <key>com.apple.security.temporary-exception.apple-events</key>
    <array>
        <string>com.apple.systemevents</string>
    </array>

    <!-- iCloud key-value storage, for syncing settings and the dictionary.

         RESTRICTED entitlements: unlike everything above, these are only
         honoured when the bundle also carries the provisioning profile that
         grants them. build_distribution.sh embeds that profile — the two must
         stay together. Signing with these keys and no embedded profile
         produces an app that refuses to launch, for everyone. -->
    <key>com.apple.application-identifier</key>
    <string>B8R5B24PMP.com.push.voicetotext</string>

    <key>com.apple.developer.team-identifier</key>
    <string>B8R5B24PMP</string>

    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>B8R5B24PMP.com.push.voicetotext</string>
</dict>
</plist>
