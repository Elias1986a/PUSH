<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>PUSH</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>com.push.voicetotext</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>PUSH</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>4.1.3</string>
    <key>CFBundleVersion</key>
    <string>31</string>

    <!-- Menu bar app (no dock icon) -->
    <key>LSUIElement</key>
    <true/>

    <!-- Minimum macOS version -->
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>

    <!-- Microphone permission -->
    <key>NSMicrophoneUsageDescription</key>
    <string>PUSH needs microphone access to transcribe your speech into text.</string>

    <!-- Background audio -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- App Transport Security (for model downloads from HuggingFace) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>huggingface.co</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <false/>
                <key>NSIncludesSubdomains</key>
                <true/>
            </dict>
        </dict>
    </dict>

    <!-- Hardened runtime entitlements note -->
    <!-- See PUSH.entitlements for accessibility and audio permissions -->

    <!-- Sparkle auto-update -->
    <!-- Appcast feed (served from the repo's main branch). -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/Elias1986a/PUSH/main/appcast.xml</string>
    <!-- EdDSA public key; private key lives in the login Keychain (generate_keys). -->
    <key>SUPublicEDKey</key>
    <string>mZgb4K+4aV6djmFAUuIl2WKw2ou7iuzdr8Ey35A6mgQ=</string>
    <!-- Check automatically; user is prompted on first launch. Daily interval. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
