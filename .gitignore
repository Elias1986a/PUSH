# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
*.xcscheme
DerivedData/
build/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.moved-aside

# Swift Package Manager
.build
# ".build 2", ".build 3" — Finder and iCloud make numbered duplicates of the
# symlink, and the bare `.build` rule does not match them. Two of them reached
# the repo as absolute symlinks into one machine's home directory.
.build [0-9]*
.swiftpm/
Packages/
# Package.resolved — tracked for CI reproducibility

# CocoaPods
Pods/
Podfile.lock

# Carthage
Carthage/Build/
Carthage/Checkouts/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Models (large files)
*.bin
*.gguf

# Temporary files
*.swp
*.swo
*~
/tmp/push_debug.log
PUSH.app/
.DS_Store

# Build artifacts
PUSH-Xcode/
*.dmg
*.zip

# Icon work-in-progress (keep .icns for CI builds)
ICON/*
!ICON/AppIcon.icns
PUSH/Resources/Assets.xcassets/AppIcon.appiconset/*.png

# Firebase
firebase-debug.log
firestore-debug.log
ui-debug.log

# Claude Code
.claude/
# ...except the Remotion agent skills the studio ships (links into .agents/skills)
!promo/studio/.claude/
promo/studio/.claude/*
!promo/studio/.claude/skills/
# ...and the project's own skills (/promo), not its local settings
!/.claude/
/.claude/*
!/.claude/skills/
build.log
dist-build/

# Local comparison tool build output
compare/.build/

# Local Claude Code permissions — machine paths, never for a public repo
.claude/settings.local.json

# compare/.build is a symlink out of iCloud (see root .build)
compare/.build
eval/.rules_output.json
eval/.server.log
eval/.llm_eval_results.json
eval/.autocomplete_eval.json
__pycache__/

# iCloud duplicates ("name 2.md") of docs: identical copies, never meant for the repo.
docs/**/* [0-9].md

# Content library: finished videos, reusable assets, screen-take masters (content/raw/takes/).
# iCloud-backed, never sent to GitHub. See content/README.md.
/content/
